# ─────────────────────────────────────────────────────────────
# Playlabi Currículo — variables de entorno
# Copia este archivo como .env y rellena los valores.
# El .env real NUNCA se sube al repositorio.
# ─────────────────────────────────────────────────────────────

# Obligatorio: clave de la API de Anthropic (generación de documentos)
ANTHROPIC_API_KEY=

# Puerto del servidor de la API
API_PORT=3002

# Cuenta de administración. Se crea sola al arrancar el servidor.
# No se puede crear un admin desde el registro público: solo desde aquí.
ADMIN_NAME=Administración
ADMIN_EMAIL=
ADMIN_PASSWORD=

# URL pública de la aplicación (se usa en los correos y en los enlaces
# compartidos que abren el QR y el embed)
APP_URL=http://localhost:5176

# Base de datos.
# Sin DATABASE_URL usa SQLite en ./datos/curriculo.db (desarrollo local).
# Con DATABASE_URL usa PostgreSQL (Neon o Supabase), necesario en Netlify.
# DATABASE_URL=postgres://usuario:clave@host/base

# Correo (opcional). Sin esto la aplicación funciona igual, pero los avisos
# de registro quedan solo en el panel de administración.
# RESEND_API_KEY=
# MAIL_FROM=Playlabi Currículo <curriculo@tudominio.com>
